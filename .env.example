# Copy to .env (`make setup` does this). Nothing here is secret by default: everything runs
# locally and free. Never commit .env.

# --- LLM (LiteLLM model string) ---
# Default: local Ollama. Install Ollama, then `make models` pulls the model.
LLM_MODEL=ollama/qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=180
# Optional paid providers (set LLM_MODEL accordingly):
# LLM_MODEL=openai/gpt-4o-mini            + OPENAI_API_KEY=...
# LLM_MODEL=azure/<deployment-name>       + AZURE_API_KEY=... AZURE_API_BASE=... AZURE_API_VERSION=...
# LLM_MODEL=anthropic/claude-3-5-haiku-latest + ANTHROPIC_API_KEY=...

# --- Retrieval (local sentence-transformers models, downloaded once) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
FINBERT_MODEL=ProsusAI/finbert
CHUNK_TOKENS=500
CHUNK_OVERLAP=0.15
RETRIEVE_CANDIDATES=20
RETRIEVE_TOP_K=5
# After the first download, run fully offline:
# HF_HUB_OFFLINE=1

# --- Scraper ---
SCRAPE_FROM_YEAR=2015
SCRAPE_DELAY_SECONDS=1.5

# --- API ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
SQL_MAX_ROWS=500
